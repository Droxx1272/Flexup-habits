// FlexUp API — a thin proxy so the Anthropic key never ships in the app,
// answering only genuine copies of the app (App Attest).
// Setup and day-to-day commands: see README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flexup-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    // Your Apple Developer Team ID (10 characters) — Xcode → target →
    // Signing & Capabilities, or developer.apple.com → Membership.
    "APPLE_TEAM_ID": "",
    "APPLE_BUNDLE_ID": "com.flexup.FlexUp",
    // "required": only App Attest–verified installs get estimates. "off": skip it.
    "ATTEST_MODE": "required",
    // Builds run from Xcode attest in Apple's development environment. Set to
    // "false" once every user is on an App Store / TestFlight build with the
    // App Attest capability set to production.
    "ALLOW_DEVELOPMENT_ATTESTATION": "true"
  },

  // One small record per install (its public key). Created automatically
  // on the first `npm run deploy`, which writes the ID back into this file.
  "kv_namespaces": [{ "binding": "ATTEST_KEYS" }],

  // Abuse brakes. The hard ceiling on spend is the monthly limit you set in
  // the Claude Console — these stop one device or IP from burning it.
  "ratelimits": [
    // Per verified install: a meal plus a couple of re-estimates is ~3 calls.
    { "name": "INSTALL_LIMITER", "namespace_id": "1001", "simple": { "limit": 8, "period": 60 } },
    // Per IP, across all endpoints: allows a household sharing one connection.
    { "name": "IP_LIMITER", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } },
    // Makes each 60-second challenge single-use.
    { "name": "CHALLENGE_ONCE", "namespace_id": "1003", "simple": { "limit": 1, "period": 60 } }
  ]
}
